PORT=8080
DATABASE_URL=postgres://zetrc:zetrc@localhost:5432/zetrc?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=24
OTP_TTL_MINUTES=10
ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# --- Notifications (SMS / WhatsApp) ---
# Comma-separated: log (prints to server log, default), africastalking, whatsapp
NOTIFY_CHANNELS=log
# Africa's Talking SMS (use AT_USERNAME=sandbox for testing)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# WhatsApp Cloud API (Meta). Messages outside a 24h chat window need an approved template.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=

# Continuous assessment pass mark (%) used for certificates and at-risk flags
CA_PASS_MARK=50
